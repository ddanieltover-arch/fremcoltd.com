# App (canonical host is www — apex redirects there)
NEXT_PUBLIC_URL=https://www.fremcoltd.com
NEXT_PUBLIC_SITE_NAME="FREEM ENTERPRISE CO., LTD"

# Email (Resend) — required for contact / quote / newsletter forms
# 1. Create an API key: https://resend.com/api-keys
# 2. Verify the domain fremcoltd.com in Resend (DNS records)
# 3. Set EMAIL_FROM to an address on that verified domain
RESEND_API_KEY=re_xxxxxxxx

# Where admin notifications are delivered
CONTACT_EMAIL=sales@fremcoltd.com

# Sender address — MUST use a domain verified in Resend (not onboarding@resend.dev)
EMAIL_FROM="FREEM Enterprise <notifications@fremcoltd.com>"

# Optional analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# After deploy, check: GET /api/email-health
# Expect { "ok": true, "resendConfigured": true, "usingOnboardingFrom": false }

# Admin CMS (Prisma + Auth.js) — Supabase Postgres
# Dashboard → Project Settings → Database → Connection string (Session pooler :5432)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Required on Vercel — Auth.js will return "server configuration" errors without these
AUTH_SECRET=generate-a-long-random-string
# Must match the canonical host users hit (this project redirects apex → www)
AUTH_URL=https://www.fremcoltd.com
ADMIN_EMAIL=sales@fremcoltd.com
ADMIN_PASSWORD=changeme-admin
ADMIN_NAME="FREEM Admin"
