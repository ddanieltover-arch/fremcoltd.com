# App
NEXT_PUBLIC_URL=https://fremcoltd.com
NEXT_PUBLIC_SITE_NAME="FREEM ENTERPRISE CO., LTD"

# Email (Resend) — required for contact / quote / newsletter forms
# 1. Create an API key: https://resend.com/api-keys
# 2. Verify the domain fremcoltd.com in Resend (DNS records)
# 3. Set EMAIL_FROM to an address on that verified domain
RESEND_API_KEY=re_xxxxxxxx

# Where admin notifications are delivered
CONTACT_EMAIL=sales@fremcoltd.com

# Sender address — MUST use a domain verified in Resend (not onboarding@resend.dev)
EMAIL_FROM="FREEM Enterprise <notifications@fremcoltd.com>"

# Optional analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# After deploy, check: GET /api/email-health
# Expect { "ok": true, "resendConfigured": true, "usingOnboardingFrom": false }

# Admin CMS (Prisma + Auth.js)
# Local SQLite (relative to web/prisma). Production: use a Postgres DATABASE_URL.
DATABASE_URL="file:./dev.db"
AUTH_SECRET=generate-a-long-random-string
ADMIN_EMAIL=sales@fremcoltd.com
ADMIN_PASSWORD=changeme-admin
ADMIN_NAME="FREEM Admin"
